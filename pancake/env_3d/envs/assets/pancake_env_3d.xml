                        <geom name="rim_h01" type="capsule" fromto="0.1260 0.0000 0.0300  0.1198 0.0389 0.0300" size="0.0110" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
                        <geom name="rim_h02" type="capsule" fromto="0.1198 0.0389 0.0300  0.1019 0.0741 0.0300" size="0.0110" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
