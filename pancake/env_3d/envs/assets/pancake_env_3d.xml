                        <geom name="rim_l12" type="capsule" fromto="-0.1046 -0.0340 0.0180  -0.0890 -0.0647 0.0180" size="0.0090" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
                        <geom name="rim_l13" type="capsule" fromto="-0.0890 -0.0647 0.0180  -0.0647 -0.0890 0.0180" size="0.0090" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
                        <geom name="rim_l14" type="capsule" fromto="-0.0647 -0.0890 0.0180  -0.0340 -0.1046 0.0180" size="0.0090" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
                        <geom name="rim_l15" type="capsule" fromto="-0.0340 -0.1046 0.0180  -0.0000 -0.1100 0.0180" size="0.0090" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
                        <geom name="rim_l16" type="capsule" fromto="-0.0000 -0.1100 0.0180  0.0340 -0.1046 0.0180" size="0.0090" rgba="0 0 0 0" contype="1" conaffinity="2" condim="3" friction="0.2 0.005 0.001" solref="0.004 1"/>
